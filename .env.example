# ==============================================================================
# EmHa Elektro — Proměnné prostředí pro analytiku
# ==============================================================================
# Zkopírujte tento soubor jako `.env.production` nebo `.env.local` a doplňte
# reálná ID získaná z administrace Google Analytics a Microsoft Clarity.

# Google Analytics 4 (GA4) Measurement ID (formát G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Microsoft Clarity Project ID (formát např. abcde12345)
VITE_CLARITY_PROJECT_ID=XXXXXXXXXX
